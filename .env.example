# Vultr Serverless Inference (OpenAI-compatible): https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
# Model ids: pick from GET https://api.vultrinference.com/v1/models
PLANNER_MODEL=
# Optional vision-capable model id for screenshot checks. Leave empty to skip.
VISION_MODEL=
# Shared secret between orchestrator and egress proxy. Generate: openssl rand -hex 24
PROXY_ADMIN_TOKEN=
# gVisor runtime (installed by scripts/setup-vultr.sh). Empty = plain runc.
SANDBOX_RUNTIME=runsc
# Public address: ":80" for plain HTTP, or "<your-ip>.sslip.io" for automatic HTTPS
SITE_ADDRESS=:80
DATA_DIR=/opt/receipts/data
